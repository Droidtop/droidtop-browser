{
  "manifest_version": 2,
  "name": "droidtop session",
  "version": "2.0",
  "description": "Puts droidtop's web session into a private tab and reads it back: the browser's side of droidtop's web.view.",
  "browser_specific_settings": {
    "gecko": {
      "id": "droidtop-session@droidtop.dev"
    }
  },
  "incognito": "spanning",
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "droidtopSessionCookies": {
      "schema": "session-schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "session-api.js",
        "paths": [["droidtopSessionCookies"]]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ]
}
